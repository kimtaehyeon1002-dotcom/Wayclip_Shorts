# ── 로컬 실행용 (.env 는 gitignore). GitHub Actions 에선 같은 이름의 Secrets 로 들어온다. ──

# Cloudflare R2 — 결재본 보관 버킷(프라이빗). 맥의 tools/upload-output.mjs 도 이 키를 쓴다.
# 발급: Cloudflare 대시보드 → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shorts-publish

# 메일 알림 (선택) — 2단계인증 켠 Gmail 의 앱 비밀번호 16자리
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# 인스타 자격증명 — 채널×언어별 시크릿. 이름 규칙: IG_<SLUG대문자>_<LANG대문자>
#   값은 JSON 한 줄: {"igUserId":"1784…","igAccessToken":"EAA…"}
#   (로컬에선 channels.json 에 { "goodmovies": {...}, "goodmovies-tw": {...} } 로 둬도 된다)
# IG_GOODVIBESONGS_JA=
# IG_GOODMOVIES_JA=
# IG_READYACTION_JA=
# IG_THISHIPHOP_JA=
# IG_SPACE_LAB_JA=
