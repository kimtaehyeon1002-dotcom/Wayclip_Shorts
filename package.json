{
  "name": "wayclip-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Wayclip Shorts 모노레포 — 세로형 쇼츠 양산(Remotion, 맥 CLI) + 인스타 자동 게시(publisher, GitHub Actions) + 대시보드(web, GitHub Pages)",
  "type": "module",
  "scripts": {
    "gen": "node tools/gen-formats.mjs",
    "predev": "npm run gen",
    "dev": "remotion studio",
    "prerender": "npm run gen",
    "render": "remotion render",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run test -w @wayclip/shared && node --test \"tools/__tests__/*.test.mjs\"",
    "upload": "node tools/upload-output.mjs",
    "validate:formats": "node tools/gen-formats.mjs --check"
  },
  "dependencies": {
    "@remotion/cli": "4.0.475",
    "@remotion/fonts": "4.0.475",
    "@remotion/google-fonts": "4.0.475",
    "@remotion/install-whisper-cpp": "4.0.475",
    "@remotion/media-utils": "4.0.475",
    "@remotion/zod-types": "4.0.475",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.475",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "5.8.3",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "dotenv": "^16.4.5"
  },
  "workspaces": [
    "packages/shared",
    "publisher",
    "web"
  ]
}
